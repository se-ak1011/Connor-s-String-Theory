{
  "expo": {
    "name": "Connor's String Theory",
    "slug": "connors-string-theory",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "connorsstringtheory",
    "userInterfaceStyle": "light",
    "backgroundColor": "#B5ADA2",
    "ios": {
      "icon": "./assets/images/icon.png",
      "backgroundColor": "#B5ADA2",
      "bundleIdentifier": "com.connorst.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#B5ADA2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#B5ADA2"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#B5ADA2"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Connor's String Theory uses your photos to share pictures and videos of your dog's training with Connor."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Connor's String Theory uses your microphone to record voice notes for Connor."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
