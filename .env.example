# Copy to .env and fill in once you've created a Supabase project (see SETUP.md).
# These are PUBLIC values (safe to ship in the app) — the real secrets
# (Stripe key, Supabase service role key) live only in Supabase's own
# secrets manager, never in this file or in the app bundle.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
